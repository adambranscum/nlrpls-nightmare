# Shared password for the whole team (single password gate, not per-user accounts)
SITE_PASSWORD=changeme

# Random long string used to sign session tokens
SESSION_SECRET=changeme-too

# LM Studio local server (running on the Mac mini) — always localhost, LM Studio
# runs on the same machine as this backend
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen3-vl-30b
LMSTUDIO_EMBED_MODEL=nomic-embed-text-v1.5

# Self-hosted SearXNG for web search (Docker container on this same machine)
SEARXNG_URL=http://localhost:8888

# Read-only credentials for live device config fetching (SSH). Create dedicated
# monitor/read-only accounts on the switches and SonicWall — do NOT use admin creds.
ARUBA_RO_USER=
ARUBA_RO_PASS=
SONICWALL_RO_USER=
SONICWALL_RO_PASS=
SONICWALL_HOST=192.168.1.251
NLRPLS_SW_CORE_HOST=

# Backend port
PORT=4000

# Comma-separated origins allowed to call the API (your frontend URL)
CORS_ORIGIN=http://localhost:3000
